# Plantilla de configuración para el flujo de desarrollo con `go run`.
# Copiala a `.env` y ajustá los valores según tu entorno:
#
#   cp backend/.env.example backend/.env
#
# El `.env` real está ignorado por git; este ejemplo es el único que se versiona.
# Con `docker compose up` NO necesitás nada de esto: el compose ya setea todo.

# Conexión a PostgreSQL.
# El Postgres de Docker se publica en el host en el puerto 5433 (el 5432 suele
# estar ocupado por un Postgres nativo). Para correr el backend con `go run`
# contra la DB de Docker, apuntá al 5433. Ver docs/entorno-docker.md.
DATABASE_URL=postgres://outbox:outbox@localhost:5433/outbox_lab?sslmode=disable

# Dirección de escucha del servidor HTTP.
HTTP_ADDR=:8080

# Período del ticker del relay (cada cuánto drena la outbox).
RELAY_INTERVAL=1s

# Máximo de eventos publicados por tick.
RELAY_BATCH=50
